# SentinelAI Environment Configuration
#
# Copy this file to .env for local development.
# Never commit .env or real secrets to Git.

# Runtime
NODE_ENV=development
PORT=3000

# Backend
BACKEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://sentinelai:sentinelai@localhost:5432/sentinelai

# Cache / Queue
REDIS_URL=redis://localhost:6379

# AI / LLM
OPENAI_API_KEY=

# Authentication
JWT_SECRET=

# Simulation Engine
SIMULATION_TARGET=http://localhost:3000
SIMULATION_INTERVAL=5000
